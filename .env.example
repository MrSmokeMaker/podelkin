# Порт dev-сервера Next.js (фронтенд и API в одном процессе)
PORT=3000

# Язык интерфейса и локаль поиска
LANG=ru

# --- Монетизация ---
# Режим тарифов: local | staging | production (влияет на тестовые сценарии оплаты)
MONETIZATION_MODE=local
# Роль по умолчанию для запросов без ?role= / x-user-role: free | premium | admin
DEFAULT_ROLE=free
# Офлайн-синхронизация Premium (предкэш топ-50 поделок и проектов).
# Пока false — синхронизация запускается только вручную (см. README, раздел PWA).
ENABLE_OFFLINE_SYNC=false

# Зарезервировано для будущей миграции на PostgreSQL + Prisma.
# Сейчас слой данных работает в памяти (см. src/lib/db.ts), DATABASE_URL не используется.
# DATABASE_URL=postgresql://rukodelie:rukodelie@localhost:5432/rukodelie
