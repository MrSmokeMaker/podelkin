# База данных PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podelkin

# Порт dev-сервера Next.js (фронтенд и API в одном процессе)
PORT=3000

# Язык интерфейса и локаль поиска
LANG=ru

# --- Монетизация ---
# Режим тарифов: local | staging | production (влияет на тестовые сценарии оплаты)
MONETIZATION_MODE=local
# Роль по умолчанию для запросов без ?role= / x-user-role: free | premium | admin
DEFAULT_ROLE=free
# Офлайн-синхронизация Premium (предкэш топ-50 поделок и проектов).
# Пока false — синхронизация запускается только вручную (см. README, раздел PWA).
ENABLE_OFFLINE_SYNC=false

# --- AI-генерация (весь ИИ — через воркер-шлюз cloudflare/worker.js) ---
# Адрес задеплоенного воркера: https://craft-image-worker.<ваш-субдомен>.workers.dev
# Заполняется ПОСЛЕ деплоя воркера (cd cloudflare && npx wrangler deploy).
# Секретов здесь нет: MISTRAL_API_KEY живёт только в секрете воркера
# (npx wrangler secret put MISTRAL_API_KEY), приложению он не нужен.
# WORKER_URL=https://craft-image-worker.example.workers.dev
# Кэш готовых черновиков (сутки): true — повторные темы/ссылки не тратят квоту ИИ.
CACHE_LLM=true
# Лимит генераций черновиков на пользователя в сутки.
GEN_PER_USER_PER_DAY=5
# Дневная квота картинок для отображения остатка в статистике.
# Реальный лимит задаёт тариф Workers AI воркера; приложение только показывает остаток.
IMAGE_QUOTA_PER_DAY=2000
